# Copy to .env (or just export these before running uvicorn).

# Set to 1 to test the full app (queue, progress, history, playback) with a
# fast synthetic clip instead of downloading and running the real model.
# Start here before attempting a real generation.
VYDEA_MOCK_MODEL=1

# Set to 0 only if you have 12GB+ VRAM and want to disable CPU offload for
# speed. Leave at 1 for a 4GB card like the RTX 3050.
VYDEA_LOW_VRAM=1

# Where Hugging Face model weights get cached (can be several GB).
HF_HOME=./hf_cache
